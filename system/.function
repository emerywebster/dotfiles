#!/usr/bin/env bash

function df-help () {
  echo "Usage: df-<command>"
  echo
  echo "Commands:"
  echo "   clean            Clean up caches (brew, nvm, gem)"
  echo "   edit             Open dotfiles in IDE ($DOTFILES_IDE) and Git GUI ($DOTFILES_GIT_GUI)"
  echo "   help             This help message"
  echo "   update           Update packages and pkg managers (OS, brew, npm, gem)"
}

function df-edit () {
  sh -c "$DOTFILES_IDE $DOTFILES_DIR"
  sh -c "$DOTFILES_GIT_GUI $DOTFILES_DIR"
}

function df-update () {
  sudo softwareupdate -i -a
  brew update
  brew upgrade
  brew autoremove
  npm update -g
  gem update --system
  gem update
}

function df-clean () {
  brew cleanup
  gem cleanup
  . "$NVM_DIR/nvm.sh"; nvm cache clear
}


function gh-pages-deploy () {
  directory=_site
  current_branch=$(git rev-parse --abbrev-ref HEAD)
  deploy_branch=gh-pages
  build_command() {
    bundle exec jekyll build
  }

  if [[ "$current_branch" != "main" ]]; then
    echo "\033[0;32mAborting - switch to 'main' branch\033[0m";
  else
    echo -e "\033[0;32mDeleting old content...\033[0m"
    rm -rf $directory

    echo -e "\033[0;32mChecking out $deploy_branch....\033[0m"
    git worktree add $directory $deploy_branch

    echo -e "\033[0;32mGenerating site...\033[0m"
    build_command

    echo -e "\033[0;32mDeploying $deploy_branch branch...\033[0m"
    cd $directory &&
      git add --all &&
      git commit -m "Deploy updates" &&
      git push origin $deploy_branch

    echo -e "\033[0;32mCleaning up...\033[0m"
    cd ..
    git worktree remove $directory

  fi
}

# grep alias shortcut
al() {
	 alias | grep -e $1
 }

 function dockerclean() {
   echo stopping containers...
  docker stop $(docker ps -q)

  echo removing stopped containers
  docker container prune -f

  echo removing volumes
  docker volume prune -f

  echo pruning networks:
  docker network prune -f
 }

# Emit one tab-separated "port<TAB>pid<TAB>command<TAB>cwd" line per TCP socket
# the current user is listening on. Pass 1 to include GUI-app/system noise
# (Bonjour, Electron helpers, daemons); anything else keeps only things started
# from a real project directory. Shared by `servers` and `killport`.
function _servers_raw () {
  local all="${1:-0}"

  # -a ANDs the selections; without it lsof ORs -i and -u and returns every open file
  lsof -a -iTCP -sTCP:LISTEN -n -P -u "$USER" 2>/dev/null \
  | awk 'NR>1 {
      pid=$2
      # the address column position shifts (IPv4/IPv6, trailing "(LISTEN)"),
      # so take the last field that looks like host:port
      addr=""
      for (i=NF; i>=1; i--) if ($i ~ /:[0-9]+$/) { addr=$i; break }
      if (addr == "") next
      port=addr; sub(/^.*:/,"",port)
      key=pid":"port
      if (!seen[key]++) print pid, port
    }' \
  | while read -r pid port; do
      cmd=$(ps -p "$pid" -o comm= 2>/dev/null)
      cmd=${cmd##*/}
      cwd=$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | awk '/^n/ {print substr($0,2); exit}')

      if [[ "$all" != 1 ]]; then
        # Bonjour / AirPlay / peer-discovery chatter, not dev servers
        [[ "$port" == 5353 || "$port" == 16384 || "$port" == 7000 ]] && continue
        # Electron & friends spawn a helper per tab/window
        case "$cmd" in
          *Helper*|*"(Renderer)"*|*"(Service)"*|*"(GPU)"*|*Crash-Handler*) continue ;;
        esac
        # Apps and daemons run from / or a sandbox container; dev servers run from a project
        [[ -z "$cwd" || "$cwd" == "/" || "$cwd" == "$HOME/Library"* ]] && continue
      fi

      printf '%s\t%s\t%s\t%s\n' "$port" "$pid" "${cmd:-?}" "$cwd"
    done \
  | sort -n
}

# Print one server per line, padded into columns.
function _servers_row () {
  local port="$1" pid="$2" cmd="$3" cwd="$4"
  # keep COMMAND inside its column so PROJECT stays aligned (ASCII "..." so the
  # padding maths matches the byte count)
  (( ${#cmd} > 24 )) && cmd="${cmd:0:21}..."
  printf "%-7s %-8s %-24s %s\n" "$port" "$pid" "$cmd" "${cwd/#$HOME/~}"
}

# List local servers listening on TCP ports: port, PID, command, project dir.
# By default hides GUI-app/system noise and shows things started from a real
# project directory. `servers -a` shows everything.
function servers () {
  local all=0
  [[ "$1" == "-a" || "$1" == "--all" ]] && all=1

  printf "%-7s %-8s %-24s %s\n" "PORT" "PID" "COMMAND" "PROJECT"
  printf '%s\n' "----------------------------------------------------------------------------"

  _servers_raw "$all" | while IFS=$'\t' read -r port pid cmd cwd; do
    _servers_row "$port" "$pid" "$cmd" "$cwd"
  done
}

# Kill whatever is listening on a port: killport 3000 [-9]
# Also takes a command or project substring: killport corrado
# With no argument, lists the running servers and prompts for a port.
function killport () {
  local target="$1" sig="${2:--TERM}"

  if [[ -z "$target" ]]; then
    servers
    printf '\nPort to kill (blank to cancel): '
    read -r target
    [[ -z "$target" ]] && return 1
  fi

  local pids
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    pids=$(lsof -tiTCP:"$target" -sTCP:LISTEN 2>/dev/null)
    if [[ -z "$pids" ]]; then
      echo "Nothing listening on port $target"
      return 1
    fi
  else
    # not a port number - match it against the command and project columns
    local matches
    matches=$(_servers_raw 0 | grep -i -- "$target")
    if [[ -z "$matches" ]]; then
      echo "No server matching '$target'"
      return 1
    fi
    if (( $(printf '%s\n' "$matches" | wc -l) > 1 )); then
      echo "Multiple servers match '$target':"
      printf '%s\n' "$matches" | while IFS=$'\t' read -r p i c w; do
        _servers_row "$p" "$i" "$c" "$w"
      done
      echo "Re-run with a port number."
      return 1
    fi
    target=$(printf '%s\n' "$matches" | cut -f1)
    pids=$(printf '%s\n' "$matches" | cut -f2)
  fi

  echo "$pids" | while read -r pid; do
    cmd=$(ps -p "$pid" -o comm= 2>/dev/null)
    echo "Killing ${cmd##*/} (PID $pid) on port $target"
    kill "$sig" "$pid"
  done
}
